#!/usr/bin/env bash
# Read-only inspection of a RunPod container startup hook.
# Configurable paths exist exclusively for offline testing.
set -euo pipefail

start="${RUNPOD_PREFLIGHT_START:-/start.sh}"
hook="${RUNPOD_PREFLIGHT_HOOK:-/post_start.sh}"
workspace="${RUNPOD_PREFLIGHT_WORKSPACE:-/workspace}"

echo "=== RunPod startup preflight (read-only) ==="
if [[ ! -f "$start" ]]; then
  echo "MISSING: startup script"
  exit 2
fi
echo "Startup script exists"

# Ignore comment-only lines. Confirm the expected path is present in an
# executable statement, not merely mentioned in documentation.
if ! grep -E '^[[:space:]]*[^#[:space:]].*post_start[.]sh' "$start" |
     grep -Fq "$hook"; then
  echo "NOT VERIFIED: executable post-start hook invocation"
  echo "Review the actual startup script before making changes."
  exit 3
fi
echo "CANDIDATE: post-start hook appears in active startup code"
echo "MANUAL REVIEW REQUIRED: verify invocation order and execution semantics"

if [[ -e "$hook" || -L "$hook" ]]; then
  echo "EXISTS: hook path; never overwrite an existing file"
else
  echo "ABSENT: hook path"
fi
if [[ ! -d "$workspace" ]]; then
  echo "MISSING: persistent workspace"
  exit 4
fi
echo "Workspace directory exists"
echo "Read-only inspection finished. No hook was installed or enabled."
