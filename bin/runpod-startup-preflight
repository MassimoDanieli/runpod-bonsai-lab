#!/usr/bin/env bash
# Read-only inspection of startup behavior on a running RunPod container.
# Never prints the environment, credentials, or SSH authorized_keys.
set -euo pipefail
start="/start.sh"
echo "=== RunPod startup preflight (read-only) ==="
if [[ ! -f "$start" ]]; then
  echo "MISSING: $start"
  exit 2
fi
echo "Startup script exists: $start"
if grep -Eq 'execute_script[[:space:]]+["'\'' ]?/post_start[.]sh' "$start"; then
  echo "FOUND: post-start hook invocation"
else
  echo "NOT FOUND: expected /post_start.sh invocation"
  echo "Do not install a hook until startup behavior is reviewed."
  exit 3
fi
if [[ -e /post_start.sh || -L /post_start.sh ]]; then
  echo "EXISTS: /post_start.sh; do not replace without reviewing it."
else
  echo "ABSENT: /post_start.sh"
fi
if [[ -d /workspace ]]; then
  echo "FOUND: /workspace directory"
else
  echo "MISSING: /workspace directory"
  exit 4
fi
echo "Read-only preflight completed. No changes made."
