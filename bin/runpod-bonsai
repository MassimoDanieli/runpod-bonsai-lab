#!/usr/bin/env bash
# RunPod Bonsai controller: REST API operations for an existing Pod.
# Requires: curl, jq, ~/.config/runpod.env (mode 600).
set -euo pipefail

CONFIG="${RUNPOD_BONSAI_CONFIG:-$HOME/.config/runpod.env}"
API="https://api.runpod.io/v2/pods"

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
usage() { echo "Usage: runpod-bonsai {status|endpoint|start|stop}"; }

[[ -r "$CONFIG" ]] || die "Missing config: $CONFIG"
# shellcheck source=/dev/null
source "$CONFIG"
: "${RUNPOD_API_KEY:?RUNPOD_API_KEY is missing}"
: "${RUNPOD_POD_ID:?RUNPOD_POD_ID is missing}"
[[ "$RUNPOD_POD_ID" =~ ^[A-Za-z0-9_-]+$ ]] || die "Invalid Pod ID"
command -v curl >/dev/null || die "curl is required"
command -v jq >/dev/null || die "jq is required"
URL="$API/$RUNPOD_POD_ID"

api_get() {
  curl --fail --silent --show-error --connect-timeout 10 --max-time 30 \
    -H "Authorization: Bearer ${RUNPOD_API_KEY}" "$URL"
}
api_action() {
  local action="$1" body http_code detail
  body="$(mktemp)" || die "Unable to create response buffer"
  # Capture the error body as well as the HTTP code: curl -f discards the useful
  # JSON explanation for rejected Pod starts (e.g. unavailable host GPU).
  if ! http_code="$(curl --silent --show-error --connect-timeout 10 --max-time 60 \
      -o "$body" -w '%{http_code}' \
      -X POST -H "Authorization: Bearer ${RUNPOD_API_KEY}" \
      -H "Content-Type: application/json" \
      --data "{\"action\":\"$action\"}" "$URL/action")"; then
    rm -f "$body"
    die "RunPod API connection failed. No automatic retry was made."
  fi
  if [[ ! "$http_code" =~ ^2[0-9][0-9]$ ]]; then
    detail="$(jq -r '.detail // .message // .title // empty' "$body" 2>/dev/null || true)"
    rm -f "$body"
    if [[ "$action" == start && "$http_code" == 400 &&
          "$detail" == *"not enough free GPUs"* ]]; then
      printf 'GPU_UNAVAILABLE: %s\n' "$detail" >&2
      echo "The existing Pod was preserved. No additional Pod was created." >&2
      return 3
    fi
    printf 'RUNPOD_API_ERROR: action=%s HTTP=%s %s\n' "$action" "$http_code" "$detail" >&2
    return 1
  fi
  cat "$body"
  rm -f "$body"
}
get_state() {
  api_get | jq -er '.status | select(type == "string" and length > 0)'
}
status() {
  api_get | jq -er '
    select(.id != null and .name != null and .status != null) |
    "Pod: \(.name)\nID: \(.id)\nStatus: \(.status)"
  '
  if curl --fail --silent --show-error --connect-timeout 1 --max-time 3 \
    http://127.0.0.1:18082/health >/dev/null 2>&1; then
    echo "Cloud model API: reachable via local tunnel"
  else
    echo "Cloud model API: unavailable (normal when Pod is stopped)"
  fi
}
case "${1:-}" in
  status) status ;;
  endpoint)
    # Emit exactly two lines for consumption by runpod-tunnel: IP and public SSH port.
    api_get | jq -er '
      if .status != "RUNNING" then
        error("Pod is not RUNNING")
      else
        [.runtime.ports[]? | select(.type == "tcp" and .private == 22 and (.ip | type == "string") and (.public | type == "number"))] |
        if length != 1 then error("Expected exactly one active TCP SSH mapping") else
          .[0] | select(.public >= 1 and .public <= 65535) |
          .ip, (.public | tostring)
        end
      end
    '
    ;;
  start)
    state="$(get_state)" || die "Could not determine current Pod status"
    if [[ "$state" == RUNNING ]]; then
      echo "Pod already running."
      exit 0
    fi
    echo "Current status: $state"
    echo "Starting the Pod incurs GPU and storage charges."
    read -r -p "Start RunPod? [yes/NO] " answer
    [[ "$answer" == yes ]] || { echo "Cancelled."; exit 0; }
    api_action start | jq .
    echo "Start requested. Check: runpod-bonsai status"
    ;;
  stop)
    state="$(get_state)" || die "Could not determine current Pod status"
    if [[ "$state" == EXITED ]]; then
      echo "Pod already stopped."
      exit 0
    fi
    api_action stop | jq .
    echo "Stop requested. Check: runpod-bonsai status"
    echo "If an SSH forward is running, stop it separately."
    ;;
  *) usage >&2; exit 2 ;;
esac
