#!/usr/bin/env bash
# Compatibility entrypoint: start the managed server AND dry-run watchdog pair.
# Run on the Pod. This is not a RunPod boot hook and does not stop GPU billing.
set -euo pipefail
here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
exec python3 "$here/bonsai-pod.py" start "$@"
