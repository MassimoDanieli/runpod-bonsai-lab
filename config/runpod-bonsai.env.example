# Copy once to ~/.config/runpod.env with mode 600. Never overwrite a real config.
# Parsed as data, not sourced as shell. NAME=value, quotes, comments and optional
# `export` are supported. No shell substitutions; HOME expands only in local paths.
RUNPOD_POD_ID=YOUR_EXISTING_POD_ID
RUNPOD_API_KEY=YOUR_RUNPOD_API_KEY
RUNPOD_LOCAL_PORT=18082
RUNPOD_REMOTE_PORT=18080
BONSAI_REMOTE_ROOT=/workspace/ai/Bonsai-demo

# Optional defaults (no personal username or host paths):
# RUNPOD_SSH_KEY="$HOME/.ssh/runpod_ed25519"
# RUNPOD_KNOWN_HOSTS="$HOME/.ssh/known_hosts_runpod"
# RUNPOD_SSH_USER=root
# RUNPOD_SSH_HOST_KEY_POLICY=accept-new
# RUNPOD_SSH_TIMEOUT=10
# RUNPOD_API_TIMEOUT=30
# RUNPOD_TUNNEL_REFRESH_SECONDS=30
# RUNPOD_TUNNEL_RETRY_SECONDS=5
# RUNPOD_TUNNEL_MAX_FAILURES=6
# RUNPOD_STATE_DIR="$HOME/.local/state/runpod-bonsai"
